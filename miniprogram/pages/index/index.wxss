.page { padding: 48rpx 42rpx 64rpx; }
.brand { display: flex; align-items: center; gap: 14rpx; font-size: 25rpx; font-weight: 600; letter-spacing: 3rpx; color: #697164; }
.brand-mark { letter-spacing: -7rpx; padding-right: 8rpx; color: #9a8f85; }
.hero { padding: 96rpx 4rpx 28rpx; }
.eyebrow { font-size: 23rpx; letter-spacing: 4rpx; color: #858a7e; }
.title { margin-top: 22rpx; font-family: serif; font-size: 66rpx; font-weight: 600; line-height: 1.3; letter-spacing: 2rpx; }
.description { margin-top: 28rpx; font-size: 27rpx; color: #777b72; line-height: 1.9; }
.heart-art { height: 250rpx; display: flex; align-items: center; justify-content: center; font-size: 150rpx; line-height: 1; color: #d8c9bd; }
.heart-art text + text { color: #cbd1c5; margin-left: -20rpx; transform: translateY(-16rpx); }
.card { border: 1rpx solid #e6e5dc; border-radius: 28rpx; padding: 36rpx; background: #fffefa; }
.card-title { font-size: 30rpx; font-weight: 600; }
.card-copy { margin-top: 18rpx; color: #777b72; font-size: 25rpx; line-height: 1.85; }
.status { display: inline-block; margin-top: 28rpx; padding: 11rpx 18rpx; border-radius: 99rpx; background: #f1f1e9; color: #747c6d; font-size: 22rpx; }
